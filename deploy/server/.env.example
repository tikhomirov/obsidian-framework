# Copy to .env next to docker-compose.yml (install.sh does it).
# Vault on the server (the folder that contains .framework/ and Проекты/).
VAULT_DIR=/srv/obsidian
# Tailscale IPv4 of the server: `tailscale ip -4`.
TAILSCALE_IP=100.64.0.1
# Owner of the vault files: `id -u` / `id -g`.
PUID=1000
PGID=1000
# ssh target of the PC (Tailscale name or IP), user@host.
OF_WORKER_SSH_TARGET=user@my-pc
TZ=UTC
# Git host of project repos (for known_hosts).
GIT_HOST=git.example.com
# Gitea на этом же хосте: порт ssh и адрес для ssh-keyscan; в контейнере GIT_HOST → host-gateway.
GIT_SSH_PORT=22
GIT_SCAN_ADDR=git.example.com
GIT_HOST_ADDR=host-gateway
# Если Docker Hub недоступен: локальный образ + Node с nodejs.org (Pi нужен Node >= 22.19).
# BASE_IMAGE=node:20-bookworm
# NODE_TARBALL_VERSION=24.13.0
